# epicstar - environment configuration template
# Copy to .env and fill in real values. NEVER commit the populated file.
# Every variable below maps 1:1 to a field in app/config.py Settings.

# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # json | text
# LOG_FILE_PATH=./logs/app.log   # optional file sink
APP_PORT=8000                    # port uvicorn listens on

# =============================================================================
# GitHub App (required)
# =============================================================================
# App ID from https://github.com/settings/apps/<your-app>
GITHUB_APP_ID=

# Webhook secret - generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# App private key - provide ONE of the two:
# 1) Path to the .pem file downloaded from GitHub
GITHUB_PRIVATE_KEY_PATH=/path/to/github-app-key.pem
# or 2) the key itself inline; \n escapes are tolerated
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEpA...\n-----END RSA PRIVATE KEY-----

# =============================================================================
# OneDev (required)
# =============================================================================
# Server root URL only - no /api or ~api suffix (the client appends ~api)
ONEDEV_API_URL=https://onedev.example.com

# OneDev login name. OneDev authenticates BOTH the REST API and git-over-HTTPS
# with USERNAME + access token over HTTP Basic; a bearer token alone gets 401.
ONEDEV_USERNAME=

# OneDev access token (created: Profile > Access Tokens; needs project read/create)
ONEDEV_API_TOKEN=

# Naming: created projects are named {prefix}{owner}-{repo}
ONEDEV_REPO_PREFIX=github-

# When a project with the target name already exists:
# use_existing | append_timestamp | fail
ONEDEV_CONFLICT_STRATEGY=use_existing

# Optional numeric id of a parent OneDev project to create repos under
ONEDEV_PROJECT_PARENT_ID=

# =============================================================================
# Database
# =============================================================================
# Development (sqlite): sqlite:///./dev.db
# Production (postgres): postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# PostgreSQL-only pool tuning (ignored by sqlite)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# Git operations (enforced with real subprocess timeouts)
# =============================================================================
GIT_CLONE_TIMEOUT=1800           # seconds
GIT_PUSH_TIMEOUT=1800            # seconds
GIT_TEMP_DIR=/tmp/git-sync
GIT_CLONE_DEPTH=0                # 0 = full clone

# =============================================================================
# Retry
# =============================================================================
MAX_RETRIES=3                    # attempts per step (OneDev API / git)
RETRY_BACKOFF_FACTOR=2
RETRY_MIN_WAIT=4                 # seconds
RETRY_MAX_WAIT=60                # seconds

# =============================================================================
# Monitoring
# =============================================================================
PROMETHEUS_ENABLED=true          # exposes GET /metrics

# =============================================================================
# Security
# =============================================================================
CORS_ENABLED=false
# Comma-separated origins, only used when CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Notes
# =============================================================================
# - Webhook secret: openssl rand -hex 32
# - Database password: openssl rand -base64 32
# - Never commit a populated .env to version control.
